<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000">

    <!-- MAIN CONTENT -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="25dp"
            android:paddingBottom="20dp">

            <!-- TOP BAR (UPDATED) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:gravity="end|center_vertical"
                android:orientation="horizontal"
                android:importantForAccessibility="no">

                <!-- CALCULATOR ICON -->
                <ImageView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:contentDescription="Calculator icon"
                    android:scaleType="centerInside"
                    android:src="@drawable/calculator_icon" />

                <!-- THREE DOT MENU -->
                <ImageView
                    android:id="@+id/btnMenu"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="16dp"
                    android:padding="12dp"
                    android:src="@android:drawable/ic_menu_more"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Open menu"
                    app:tint="#E69A60" />

            </LinearLayout>

            <!-- SUMMARY CARD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:background="@drawable/bg_salary_card">

                <!-- OVERTIME -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_overtime_icon"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="9dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Overtime"
                            android:textColor="#FFFFFF"
                            android:textSize="21sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif"/>

                        <TextView
                            android:id="@+id/txtOvertime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0.00"
                            android:textColor="#AAAAAA"
                            android:textSize="17sp"
                            android:fontFamily="sans-serif"/>

                    </LinearLayout>
                </LinearLayout>

                <!-- BASIC -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_tax_icon"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="9dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Basic Salary"
                            android:textColor="#FFFFFF"
                            android:textSize="21sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif"/>

                        <TextView
                            android:id="@+id/txtBasic"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0.00"
                            android:textColor="#AAAAAA"
                            android:textSize="17sp"
                            android:fontFamily="sans-serif"/>

                    </LinearLayout>
                </LinearLayout>

                <!-- GROSS -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_sigma_icon"
                        android:text="Σ"
                        android:textColor="#222222"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:fontFamily="sans-serif"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="9dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Gross Salary"
                            android:textColor="#FFFFFF"
                            android:textSize="21sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif"/>

                        <TextView
                            android:id="@+id/txtGross"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0.00"
                            android:textColor="#AAAAAA"
                            android:textSize="17sp"
                            android:fontFamily="sans-serif"/>

                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

            <!-- TABS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="105dp"
                android:layout_marginTop="35dp"
                android:background="@drawable/bg_salary_card"
                android:orientation="horizontal"
                android:padding="10dp"
                android:gravity="center">

                <TextView
                    android:id="@+id/tabNet"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Net"
                    android:textColor="#AAAAAA"
                    android:textSize="25sp"
                    android:gravity="center"
                    android:fontFamily="sans-serif"/>

                <TextView
                    android:id="@+id/tabGross"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Gross"
                    android:textColor="#AAAAAA"
                    android:textSize="25sp"
                    android:gravity="center"
                    android:fontFamily="sans-serif"/>

                <TextView
                    android:id="@+id/tabOvertime"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_tab_selected"
                    android:text="Overtime"
                    android:textColor="#FFFFFF"
                    android:textSize="21sp"
                    android:gravity="center"
                    android:fontFamily="sans-serif"/>

            </LinearLayout>

            <!-- BASIC SALARY -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Basic Salary"
                android:textColor="#FFFFFF"
                android:textSize="23sp"
                android:fontFamily="sans-serif"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="105dp"
                android:layout_marginTop="15dp"
                android:background="@drawable/bg_salary_card"
                android:gravity="center_vertical"
                android:padding="15dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:text="▣"
                    android:textColor="#E69A60"
                    android:textSize="32sp"
                    android:fontFamily="sans-serif"/>

                <EditText
                    android:id="@+id/edtBasicSalary"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:hint="Enter Your Basic Salary"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#999999"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif"
                    android:background="@null"
                    android:inputType="numberDecimal"
                    android:singleLine="true"/>

            </LinearLayout>

            <!-- DAY OVERTIME -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="Overtime from 6:00 AM to 10:00 PM"
                android:textColor="#FFFFFF"
                android:textSize="23sp"
                android:fontFamily="sans-serif"/>

            <!-- DAY LABELS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="12dp"
                    android:text="Hours"
                    android:textColor="#CCCCCC"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="12dp"
                    android:text="Minutes"
                    android:textColor="#CCCCCC"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="105dp"
                android:layout_marginTop="15dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/edtDayHours"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="7dp"
                    android:padding="15dp"
                    android:hint="0"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#888888"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif"
                    android:background="@drawable/bg_salary_card"
                    android:inputType="number"
                    android:singleLine="true"/>

                <EditText
                    android:id="@+id/edtDayMinutes"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="7dp"
                    android:padding="15dp"
                    android:hint="0"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#888888"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif"
                    android:background="@drawable/bg_salary_card"
                    android:inputType="number"
                    android:singleLine="true"/>

            </LinearLayout>

            <!-- NIGHT OVERTIME -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="Overtime from 10:00 PM to 6:00 AM"
                android:textColor="#FFFFFF"
                android:textSize="23sp"
                android:fontFamily="sans-serif"/>

            <!-- NIGHT LABELS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="12dp"
                    android:text="Hours"
                    android:textColor="#CCCCCC"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="12dp"
                    android:text="Minutes"
                    android:textColor="#CCCCCC"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="105dp"
                android:layout_marginTop="15dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/edtNightHours"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="7dp"
                    android:padding="15dp"
                    android:hint="0"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#888888"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif"
                    android:background="@drawable/bg_salary_card"
                    android:inputType="number"
                    android:singleLine="true"/>

                <EditText
                    android:id="@+id/edtNightMinutes"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="7dp"
                    android:padding="15dp"
                    android:hint="0"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#888888"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif"
                    android:background="@drawable/bg_salary_card"
                    android:inputType="number"
                    android:singleLine="true"/>

            </LinearLayout>

            <!-- REST DAY OVERTIME -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="Overtime on a Rest Day"
                android:textColor="#FFFFFF"
                android:textSize="23sp"
                android:fontFamily="sans-serif"/>

            <!-- REST DAY LABELS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="12dp"
                    android:text="Hours"
                    android:textColor="#CCCCCC"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="12dp"
                    android:text="Minutes"
                    android:textColor="#CCCCCC"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="105dp"
                android:layout_marginTop="15dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/edtRestHours"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="7dp"
                    android:padding="15dp"
                    android:hint="0"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#888888"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif"
                    android:background="@drawable/bg_salary_card"
                    android:inputType="number"
                    android:singleLine="true"/>

                <EditText
                    android:id="@+id/edtRestMinutes"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="7dp"
                    android:padding="15dp"
                    android:hint="0"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#888888"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif"
                    android:background="@drawable/bg_salary_card"
                    android:inputType="number"
                    android:singleLine="true"/>

            </LinearLayout>

            <!-- HOLIDAY OVERTIME -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="Overtime on a Holiday"
                android:textColor="#FFFFFF"
                android:textSize="23sp"
                android:fontFamily="sans-serif"/>

            <!-- HOLIDAY LABELS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="12dp"
                    android:text="Hours"
                    android:textColor="#CCCCCC"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="12dp"
                    android:text="Minutes"
                    android:textColor="#CCCCCC"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="105dp"
                android:layout_marginTop="15dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/edtHolidayHours"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="7dp"
                    android:padding="15dp"
                    android:hint="0"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#888888"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif"
                    android:background="@drawable/bg_salary_card"
                    android:inputType="number"
                    android:singleLine="true"/>

                <EditText
                    android:id="@+id/edtHolidayMinutes"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="7dp"
                    android:padding="15dp"
                    android:hint="0"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#888888"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif"
                    android:background="@drawable/bg_salary_card"
                    android:inputType="number"
                    android:singleLine="true"/>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- FIXED CALCULATE BUTTON -->
    <Button
        android:id="@+id/btnCalculate"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="30dp"
        android:background="@drawable/bg_calculate_button"
        android:text="Calculate"
        android:textColor="#000000"
        android:textSize="22sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif"
        android:textAllCaps="false"
        android:elevation="0dp"/>

</LinearLayout>