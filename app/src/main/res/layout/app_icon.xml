<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#191919"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="28dp">

    <!-- Ethiopian Salary Calculator -->
    <LinearLayout
        android:layout_width="110dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">

        <ImageView
            android:id="@+id/salaryIcon"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:src="@drawable/ethiopian_salary_calculator_icon"
            android:scaleType="fitCenter"
            android:contentDescription="@string/salary_calculator_desc" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/ethiopian_salary_calculator"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:gravity="center"
            android:maxLines="2" />

    </LinearLayout>

    <!-- Clock -->
    <LinearLayout
        android:layout_width="110dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">

        <ImageView
            android:id="@+id/clockIcon"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:src="@drawable/clock_icon"
            android:scaleType="fitCenter"
            android:contentDescription="@string/clock" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/clock"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:gravity="center" />

    </LinearLayout>

</LinearLayout>